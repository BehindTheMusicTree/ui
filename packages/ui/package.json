{
  "name": "@behindthemusictree/ui",
  "version": "0.17.0",
  "description": "Generic, business-logic-free UI components for BehindTheMusicTree React apps",
  "repository": {
    "type": "git",
    "url": "https://github.com/BehindTheMusicTree/ui.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@behindthemusictree/brand": "^12.10.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@behindthemusictree/brand": {
      "optional": true
    }
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.487.0",
    "react-icons": "^5.5.0",
    "tailwind-merge": "^3.2.0"
  },
  "devDependencies": {
    "@behindthemusictree/brand": "^12.10.0",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "happy-dom": "^21.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.3.7",
    "vitest": "4.1.11"
  },
  "author": "Andreas Garcia",
  "license": "ISC"
}
